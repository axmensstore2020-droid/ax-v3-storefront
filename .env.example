SHOPIFY_STORE_DOMAIN=axunisexstore.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Optional headless customer account flow. When complete, Profile stays on AX.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Generate a separate random 32+ character server-only secret.
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_SCOPE=openid email customer-account-api:full
# Server-only production token from Delhivery One. Enables tracking and live checkout rate quotes.
DELHIVERY_API_TOKEN=
# Fixed AX pickup pincode in Coimbatore.
DELHIVERY_ORIGIN_PIN=641011
# Per-order operational shipping fee added to Delhivery's quoted total (₹3 WhatsApp communication cost).
AX_SHIPPING_ORDER_FEE=3
# AX policy: Standard Delivery is free at ₹2,000+ INR. Express remains paid.
# This threshold is defined in lib/shipping-policy.js so storefront and checkout cannot drift.
# Random 32+ character server-only secret. Shopify's carrier callback URL includes this as ?key=...
AX_SHIPPING_CALLBACK_SECRET=
# Only set to an IP header overwritten by your trusted hosting proxy.
SHOPIFY_BUYER_IP_HEADER=
# Browser/session burst guard for /api/cart. Keep between 10 and 120 requests/minute.
AX_CART_BURST_LIMIT=40
# Keep false on staging. Change only for the approved production launch.
AX_ALLOW_INDEXING=false
# Canonical public origin used by metadata, structured data, robots and sitemap.
# Production: https://axstore.in (no trailing slash).
AX_PUBLIC_SITE_URL=https://axstore.in
# Optional verification token copied from Google Search Console.
GOOGLE_SITE_VERIFICATION=
# Optional: verified full Instagram profile URL.
AX_INSTAGRAM_URL=

# Optional Meta ads measurement. The browser pixel loads only after marketing consent.
# Pixel ID is not a secret, but keep configuration server-side and pass only the ID to the browser.
META_PIXEL_ID=
# Server-only Conversions API token. Never use NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=
# Set to the Graph API version shown in your Meta Events Manager / developer setup, e.g. vXX.X.
META_GRAPH_API_VERSION=
# Optional while validating events in Meta Events Manager. Remove after testing.
META_CAPI_TEST_EVENT_CODE=
# Optional: only set to an IP header that Hostinger confirms it overwrites at the proxy.
META_IP_HEADER=

# AX Stylist is disabled until you finish docs/AX-STYLIST-SETUP.md.
AX_STYLIST_ENABLED=false
AX_STYLIST_IMAGES_ENABLED=false
# Exact site origin, e.g. https://your-preview-domain.hostingersite.com (no slash).
# This is also used to reject cross-site cart, marketing and Stylist POST requests.
AX_SITE_ORIGIN=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_ADVANCED_MODEL=gpt-5.6-terra
# These defaults apply even when omitted. Overall AX_STYLIST_ENABLED still gates AI.
AX_STYLIST_ADVANCED_ENABLED=true
AX_STYLIST_ADVANCED_DAILY_LIMIT=15
AX_STYLIST_ADVANCED_THRESHOLD=4
AX_STYLIST_MEDIUM_THRESHOLD=8
AX_STYLIST_MAX_OUTPUT_TOKENS=1000
AX_STYLIST_ADVANCED_OUTPUT_TOKENS=2000
AX_STYLIST_CONTEXT_MESSAGES=6
AX_STYLIST_CONTEXT_CHARS=4800
AX_STYLIST_MAX_MODEL_CALLS=6
AX_STYLIST_MAX_TOOL_CALLS=6
AX_STYLIST_SEARCH_RESULTS=6
AX_STYLIST_TOOL_CONTEXT_CHARS=9000
AX_STYLIST_USAGE_ENABLED=true
# Random 32+ character secret; generate privately, never paste it into chat.
AX_STYLIST_SECRET=
# Optional separate 32+ character HMAC secret for anonymous funnel analytics. Falls back to AX_STYLIST_SECRET when blank.
AX_ANALYTICS_SECRET=
# Server-only Supabase Secret key. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if your project still exposes service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Shared usage ceilings; profile saves also consume one request.
AX_STYLIST_DAILY_LIMIT=150
AX_STYLIST_VISITOR_HOURLY_LIMIT=12
# Leave blank unless Hostinger confirms this header is overwritten by its proxy.
AX_STYLIST_IP_HEADER=

# Back-in-stock alerts. The customer form stays hidden until the full delivery pipeline is configured.
AX_RESTOCK_ALERTS_ENABLED=false
# Separate 32+ character HMAC secret for restock subscription IDs. Falls back to AX_STYLIST_SECRET.
AX_RESTOCK_SECRET=
# Separate 32+ character bearer secret used only by the scheduled processor endpoint.
AX_RESTOCK_PROCESSOR_SECRET=
# Resend transactional email delivery. Verify the sending domain before enabling alerts.
RESEND_API_KEY=
AX_RESTOCK_FROM_EMAIL=AX Men's Store <restock@axstore.in>

# Optional WhatsApp retention. Keep disabled until the customer opt-in flow,
# approved WhatsApp Business templates and outbound provider are ready.
AX_WHATSAPP_RETENTION_ENABLED=false
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCESS_TOKEN=
WHATSAPP_BUSINESS_API_VERSION=

# Google local inventory. Store code must exactly match the linked Google
# Business Profile. Do not enable the Storefront quantity source unless
# Shopify quantityAvailable represents this physical store's stock.
GOOGLE_LOCAL_STORE_CODE=
AX_LOCAL_INVENTORY_FROM_STOREFRONT=false
