SHOPIFY_STORE_DOMAIN=axunisexstore.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Optional headless customer account flow. When complete, Profile stays on AX.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Generate a separate random 32+ character server-only secret.
SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_SCOPE=openid email customer-account-api:full
# Server-only production token from Delhivery One. Enables live tracking enrichment on signed-in AX orders.
DELHIVERY_API_TOKEN=
# Only set to an IP header overwritten by your trusted hosting proxy.
SHOPIFY_BUYER_IP_HEADER=
# Browser/session burst guard for /api/cart. Keep between 10 and 120 requests/minute.
AX_CART_BURST_LIMIT=40
# Keep false on staging. Change only for the approved production launch.
AX_ALLOW_INDEXING=false
# Optional: verified full Instagram profile URL.
AX_INSTAGRAM_URL=

# AX Stylist is disabled until you finish docs/AX-STYLIST-SETUP.md.
AX_STYLIST_ENABLED=false
AX_STYLIST_IMAGES_ENABLED=false
# Exact site origin, e.g. https://your-preview-domain.hostingersite.com (no slash).
# This is also used to reject cross-site cart and Stylist POST requests.
AX_SITE_ORIGIN=
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-5.6-luna
OPENAI_ADVANCED_MODEL=gpt-5.6-terra
# These defaults apply even when omitted. Overall AX_STYLIST_ENABLED still gates AI.
AX_STYLIST_ADVANCED_ENABLED=true
AX_STYLIST_ADVANCED_DAILY_LIMIT=15
AX_STYLIST_ADVANCED_THRESHOLD=4
AX_STYLIST_MEDIUM_THRESHOLD=8
AX_STYLIST_MAX_OUTPUT_TOKENS=1000
AX_STYLIST_ADVANCED_OUTPUT_TOKENS=2000
AX_STYLIST_CONTEXT_MESSAGES=6
AX_STYLIST_CONTEXT_CHARS=4800
AX_STYLIST_MAX_MODEL_CALLS=6
AX_STYLIST_MAX_TOOL_CALLS=6
AX_STYLIST_SEARCH_RESULTS=6
AX_STYLIST_TOOL_CONTEXT_CHARS=9000
AX_STYLIST_USAGE_ENABLED=true
# Random 32+ character secret; generate privately, never paste it into chat.
AX_STYLIST_SECRET=
# Server-only Supabase Secret key. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if your project still exposes service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Shared usage ceilings; profile saves also consume one request.
AX_STYLIST_DAILY_LIMIT=150
AX_STYLIST_VISITOR_HOURLY_LIMIT=12
# Leave blank unless Hostinger confirms this header is overwritten by its proxy.
AX_STYLIST_IP_HEADER=
